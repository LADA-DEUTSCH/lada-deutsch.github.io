  "preposition_rules": {
    "auf": {
      "type": "two_way",
      "meaning": "on / on top of (horizontal surface)",
      "akkusativ_trigger": "movement / direction (Wohin?)",
      "dativ_trigger": "static location / rest (Wo?)",
      "contractions": {
        "akkusativ_neuter": "aufs (auf das)",
        "dativ_masculine": "auf dem",
        "dativ_neuter": "auf dem"
      }
    },
    "an": {
      "type": "two_way",
      "meaning": "at / on (vertical surface or boundary)",
      "akkusativ_trigger": "movement towards (Wohin?)",
      "dativ_trigger": "static location at (Wo?)",
      "contractions": {
        "akkusativ_neuter": "ans (an das)",
        "dativ_masculine": "am (an dem)",
        "dativ_neuter": "am (an dem)"
      }
    },
    "in": {
      "type": "two_way",
      "meaning": "in / inside (enclosed space)",
      "akkusativ_trigger": "movement into (Wohin?)",
      "dativ_trigger": "location inside (Wo?)",
      "contractions": {
        "akkusativ_neuter": "ins (in das)",
        "dativ_masculine": "im (in dem)",
        "dativ_neuter": "im (in dem)"
      }
    },
    "neben": {
      "type": "two_way",
      "meaning": "next to / beside",
      "akkusativ_trigger": "movement next to (Wohin?)",
      "dativ_trigger": "location next to (Wo?)",
      "contractions": {}
    }
  }
}
